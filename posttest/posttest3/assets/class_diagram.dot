digraph UML {
  graph [rankdir=TB, nodesep=0.5, ranksep=0.9, fontname="DejaVu Sans", bgcolor="white", pad=0.3];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#333333"];
  Person [label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF8E1"><tr><td>&laquo;abstract&raquo;<br/><b><i>Person</i></b></td></tr><hr/><tr><td align="left">#_name<br align="left"/>#_username<br align="left"/>-__password<br align="left"/>-__gmail<br align="left"/></td></tr><hr/><tr><td align="left">+get_role()<br align="left"/>+get_permissions()<br align="left"/>+can_see(notification)<br align="left"/>+update_profile()<br align="left"/></td></tr></table>>];
  Customer [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E3F2FD"><tr><td><b>Customer</b></td></tr><hr/><tr><td align="left">+id_customer<br align="left"/>+membership_tier<br align="left"/>-__total_spending<br align="left"/></td></tr><hr/><tr><td align="left">+discount_percentage<br align="left"/></td></tr></table>>];
  Admin [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E3F2FD"><tr><td><b>Admin</b></td></tr><hr/><tr><td align="left">+employee_id<br align="left"/>+branch<br align="left"/></td></tr><hr/><tr><td align="left">+accessible_branches()<br align="left"/>+record_order()<br align="left"/></td></tr></table>>];
  SuperAdmin [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E3F2FD"><tr><td><b>SuperAdmin</b></td></tr><hr/><tr><td align="left">+accessible_branches()  (semua cabang)<br align="left"/></td></tr></table>>];
  Store [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5E9"><tr><td><b>Store</b></td></tr><hr/><tr><td align="left">+name<br align="left"/>+tagline<br align="left"/>#_branches<br align="left"/></td></tr><hr/><tr><td align="left">+add_branch()<br align="left"/>+update_profile()<br align="left"/></td></tr></table>>];
  Branch [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5E9"><tr><td><b>Branch</b></td></tr><hr/><tr><td align="left">+name<br align="left"/>+address<br align="left"/>#_products<br align="left"/>#_admins<br align="left"/></td></tr><hr/><tr><td align="left">+add_product()<br align="left"/>+add_admin()<br align="left"/></td></tr></table>>];
  Product [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5E9"><tr><td><b>Product</b></td></tr><hr/><tr><td align="left">+id_product<br align="left"/>#_price<br align="left"/>#_stock<br align="left"/></td></tr><hr/><tr><td align="left">+__lt__() / __gt__()<br align="left"/></td></tr></table>>];
  OrderRequest [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF3E0"><tr><td><b>OrderRequest</b></td></tr><hr/><tr><td align="left">+id_request<br align="left"/>+status<br align="left"/>#_items<br align="left"/></td></tr><hr/><tr><td align="left">+add_item()<br align="left"/>+mark_completed()<br align="left"/></td></tr></table>>];
  Sale [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FCE4EC"><tr><td><b>Sale</b></td></tr><hr/><tr><td align="left">+id_sale<br align="left"/>#_items<br align="left"/>+payment<br align="left"/></td></tr><hr/><tr><td align="left">+add_item()<br align="left"/>+checkout(payment)<br align="left"/>+__len__()<br align="left"/></td></tr></table>>];
  SaleItem [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FCE4EC"><tr><td><b>SaleItem</b></td></tr><hr/><tr><td align="left">+product<br align="left"/>+quantity<br align="left"/>+unit_price<br align="left"/></td></tr></table>>];
  PaymentMethod [label=<<table border="2" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5"><tr><td>&laquo;abstract&raquo;<br/><b><i>PaymentMethod</i></b></td></tr><hr/><tr><td align="left">#_payer_name<br align="left"/>#_amount<br align="left"/>-__reference_code<br align="left"/></td></tr><hr/><tr><td align="left"><i>+validate()</i><br align="left"/><i>+calculate_fee()</i><br align="left"/><i>+execute()</i><br align="left"/>+process(amount)<br align="left"/></td></tr></table>>];
  Cash [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5"><tr><td><b>CashPayment</b></td></tr><hr/><tr><td align="left">+cash_given<br align="left"/></td></tr><hr/><tr><td align="left">+validate() / calculate_fee() / execute()<br align="left"/></td></tr></table>>];
  Bank [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5"><tr><td><b>BankTransferPayment</b></td></tr><hr/><tr><td align="left">-__account_number<br align="left"/></td></tr><hr/><tr><td align="left">+validate() / calculate_fee() / execute()<br align="left"/></td></tr></table>>];
  Wallet [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F3E5F5"><tr><td><b>EWalletPayment</b></td></tr><hr/><tr><td align="left">-__balance<br align="left"/></td></tr><hr/><tr><td align="left">+validate() / calculate_fee() / execute()<br align="left"/></td></tr></table>>];

  Customer -> Person [arrowhead=empty];
  Admin -> Person [arrowhead=empty];
  SuperAdmin -> Admin [arrowhead=empty];
  Cash -> PaymentMethod [arrowhead=empty];
  Bank -> PaymentMethod [arrowhead=empty];
  Wallet -> PaymentMethod [arrowhead=empty];

  Branch -> Product [dir=both, arrowtail=odiamond, arrowhead=none, label=" agregasi\n 1..*", color="#2E7D32", fontcolor="#2E7D32"];
  Branch -> Admin   [dir=both, arrowtail=odiamond, arrowhead=none, label=" agregasi\n 0..*", color="#2E7D32", fontcolor="#2E7D32"];

  Store -> Branch      [dir=both, arrowtail=diamond, arrowhead=none, label=" komposisi\n 1..*", color="#C62828", fontcolor="#C62828", penwidth=1.6];
  Sale -> SaleItem     [dir=both, arrowtail=diamond, arrowhead=none, label=" komposisi\n 1..*", color="#C62828", fontcolor="#C62828", penwidth=1.6];
  OrderRequest -> SaleItem [dir=both, arrowtail=diamond, arrowhead=none, label=" komposisi\n 1..*", color="#C62828", fontcolor="#C62828", penwidth=1.6];

  OrderRequest -> Customer [arrowhead=vee, label=" asosiasi", color="#1565C0", fontcolor="#1565C0"];
  Sale -> Customer [arrowhead=vee, label=" asosiasi", color="#1565C0", fontcolor="#1565C0"];
  Sale -> Admin [arrowhead=vee, label=" handled_by\n asosiasi", color="#1565C0", fontcolor="#1565C0"];
  Sale -> PaymentMethod [arrowhead=vee, label=" asosiasi\n 0..1", color="#1565C0", fontcolor="#1565C0"];
  SaleItem -> Product [arrowhead=vee, label=" asosiasi", color="#1565C0", fontcolor="#1565C0"];

  { rank=same; Customer; Admin; }
  { rank=same; Cash; Bank; Wallet; }
}
